# ---- Environment configuration (copy to .env and fill in) --------------
# cp .env.example .env

# Gemini / Google Generative AI key — get one free at https://aistudio.google.com/apikey
# The app works WITHOUT this key (template answers), but AI-written explanations
# and LLM query parsing need it.
GEMINI_API_KEY=your_api_key_here

# Optional: which Gemini model to use
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT=20

# ---- Data source (optional) -------------------------------------------
# Leave these empty to use the bundled sample dataset at data/crop_prices.csv.
# Point CROP_DATA_CSV / CROP_DATA_SQLITE at your own file to swap the data in.
# CROP_DATA_CSV=data/crop_prices.csv
# CROP_DATA_SQLITE=data/crop_prices.db

# ---- Real market-price REST API (optional) ----------------------------
# Set MARKET_API_URL to switch tools/market_api.py to the live REST source.
# Defaults below match the data.gov.in Agmarknet resource shape. If the call
# fails, the app automatically falls back to the local dataset.
# MARKET_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
# MARKET_API_KEY=your_data_gov_in_api_key
# MARKET_API_RECORD_LIMIT=5000
# MARKET_API_FIELD_MAP={"arrival_date":"date","commodity":"crop","market":"market","state":"state","min_price":"price_min","max_price":"price_max","modal_price":"modal_price"}
